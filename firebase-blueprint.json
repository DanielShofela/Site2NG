{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user (Candidate, Recruiter, or Admin)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["candidate", "recruiter", "admin"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "photoUrl": { "type": "string" },
        "location": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "required": ["uid", "email", "role"]
    },
    "Job": {
      "title": "Job",
      "description": "Job offer posted by a recruiter",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recruiterId": { "type": "string" },
        "companyName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string" },
        "field": { "type": "string" },
        "salary": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recruiterId", "title", "description", "location"]
    },
    "Application": {
      "title": "Application",
      "description": "Job application from a candidate",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobId": { "type": "string" },
        "candidateId": { "type": "string" },
        "recruiterId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "viewed", "shortlisted", "rejected"] },
        "appliedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "candidateId", "recruiterId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Job listings"
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Job applications"
    }
  }
}
