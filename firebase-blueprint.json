{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user (Candidate, Recruiter, or Admin)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["candidate", "recruiter", "admin"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "submitted", "verifying"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "displayName": { "type": "string" },
        "companyName": { "type": "string" },
        "phone": { "type": "string" },
        "photoUrl": { "type": "string" },
        "location": { "type": "string" },
        "sectorActivity": { "type": "string" },
        "city": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Log": {
      "title": "System Log",
      "description": "Administrative system action logs",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "target": { "type": "string" },
        "type": { "type": "string" },
        "user": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "user", "timestamp"]
    },
    "SiteConfig": {
      "title": "Site Configuration",
      "description": "CMS data for public pages",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "iconUrl": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "primaryColor": { "type": "string" }
      }
    },
    "Job": {
      "title": "Job",
      "description": "Job offer posted by a recruiter",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recruiterId": { "type": "string" },
        "companyName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string" },
        "field": { "type": "string" },
        "salary": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recruiterId", "title", "description", "location"]
    },
    "Application": {
      "title": "Application",
      "description": "Job application from a candidate",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobId": { "type": "string" },
        "candidateId": { "type": "string" },
        "recruiterId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "viewed", "shortlisted", "rejected"] },
        "appliedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "candidateId", "recruiterId"]
    },
    "SupportTicket": {
      "title": "Support Ticket",
      "description": "User feedback or support request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string", "enum": ["candidate", "recruiter", "admin"] },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "response": { "type": "string" },
        "repliedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userEmail", "userName", "userRole", "subject", "message", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Job listings"
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Job applications"
    },
    "/system_logs/{logId}": {
      "schema": "Log",
      "description": "Admin activity logs"
    },
    "/site_config/{configId}": {
      "schema": "SiteConfig",
      "description": "CMS configurations for the homepage and other public sections"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "User support tickets"
    }
  }
}
