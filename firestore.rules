rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global safety net (lowest priority)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitives & Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }
    
    // Improved isAdmin: check the users collection for the admin role
    // Using exists() + get() for maximum security, and fallback on bootstrapped email
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.email == "2ng.groupeentreprise@gmail.com" ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
    }

    function isRole(role) {
      return request.auth != null && 
             (
               (role == "admin" && request.auth.token.email == "2ng.groupeentreprise@gmail.com") ||
               (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role)
             );
    }

    // 3. User Rules
    match /users/{userId} {
      allow read: if isSignedIn() || resource.data.role == 'recruiter';
      allow create: if isOwner(userId) && 
                      incoming().uid == userId &&
                      incoming().role in ['candidate', 'recruiter', 'admin'] &&
                      (
                        (incoming().role == 'recruiter' && (incoming().status == 'pending' || incoming().status == 'submitted')) ||
                        (incoming().role == 'candidate' && incoming().status == 'approved') ||
                        (incoming().role == 'admin' && incoming().status == 'approved')
                      );
      
      allow update: if isAdmin() || (
        isOwner(userId) && 
        // Prevent owners from escalating their own role or changing critical fields
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'uid', 'email']) &&
        (incoming().status == existing().status || (existing().status == 'pending' && incoming().status == 'submitted'))
      );
      allow delete: if isAdmin();
    }

    // 4. Offer Rules
    match /offers/{offerId} {
      allow read: if true; // Public listings
      allow create: if isSignedIn();
      allow update: if isAdmin() || (
        isSignedIn() && (
          existing().createdBy == request.auth.uid || 
          existing().recruiterId == request.auth.uid || 
          existing().companyId == request.auth.uid
        )
      ) || (
        // Allow view/share/like/application engagement updates by anyone
        incoming().diff(existing()).affectedKeys().hasOnly(['views', 'shares', 'likes', 'applications'])
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (
          existing().createdBy == request.auth.uid || 
          existing().recruiterId == request.auth.uid || 
          existing().companyId == request.auth.uid
        )
      );
    }

    // Maintenance Rules
    match /maintenance/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Partner Logos Rules
    match /partner_logos/{partnerLogoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Settings / Goals Rules
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media Library Rules
    match /media/{mediaId} {
      allow read, write: if isAdmin();
    }

    // System Notifications Rules
    match /system_notifications/{noticeId} {
      allow read, write: if isAdmin();
    }

    // 5. Application Rules
    match /applications/{applicationId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          existing().candidateId == request.auth.uid || 
          existing().recruiterId == request.auth.uid
        )
      );
      allow create: if isRole('candidate') && incoming().candidateId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && (
          existing().candidateId == request.auth.uid || 
          existing().recruiterId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    // 6. System Logs Rules (Admin Only)
    match /system_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // 7. Site Config Rules
    match /site_config/{configId} {
      allow read: if true; // Anyone can see the homepage config
      allow write: if isAdmin();
    }

    // 8. Support Tickets Rules (User created, Admin managed)
    match /support_tickets/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
                    isValidId(ticketId) &&
                    incoming().userId == request.auth.uid &&
                    incoming().userRole in ['candidate', 'recruiter', 'admin'] &&
                    incoming().subject is string && incoming().subject.size() <= 300 &&
                    incoming().message is string && incoming().message.size() <= 10000 &&
                    incoming().status == 'open' &&
                    incoming().createdAt == request.time;
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
        incoming().status == 'closed'
      );
      allow delete: if isAdmin();
    }
  }
}
